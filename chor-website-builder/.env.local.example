# OpenAI: optional. Wird fuer KI-gestuetzte Struktur-Vorschlaege (Schritt "Ziel")
# genutzt. Ohne Key faellt das Tool auf eine regelbasierte Empfehlung zurueck.
OPENAI_API_KEY=

# remove.bg: optional. Wird fuer KI-Hintergrundentfernung im Bild-Editor genutzt.
# Ohne Key ist die Funktion "Hintergrund entfernen" deaktiviert.
# Key kostenlos erhaeltlich unter https://www.remove.bg/api
REMOVE_BG_API_KEY=
